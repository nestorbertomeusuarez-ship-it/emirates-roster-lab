# Copy this file to .env (and optionally .env.local for secrets) and fill in values.

# SQLite database file used by Prisma. Resolved relative to the prisma/ directory,
# so this lands at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Optional — app runs fully without it; manual CSV/JSON import is the primary path.
# Only required if you want to pull schedules from AeroDataBox (RapidAPI).
# Get a key at https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=
